# Server Configuration
# Port for the Express server to run on
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# Supabase Database
# Your Supabase project URL - found in Project Settings > API
# Format: https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key - found in Project Settings > API
# This is safe to use client-side as RLS policies protect your data
SUPABASE_ANON_KEY=your-anon-public-key-here

# Anthropic Claude AI API
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Mock AI Mode
# Set to "true" to use mock responses instead of calling Claude API (useful for development/testing)
# Set to "false" to use real Claude API
USE_MOCK_AI=false
